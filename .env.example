# Clerk authentication (server-side and public publishable key)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase project URL and publishable key for user-scoped requests
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for trusted Scout vacancy persistence.
# Use the current Supabase secret key or a legacy service_role key.
SUPABASE_SECRET_KEY=

# Protects POST /api/internal/scout/vacancies. Share this secret with Scout
# through its protected environment configuration. Never expose it to clients.
SCOUT_INGESTION_SECRET=
