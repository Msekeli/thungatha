# Temporary local-only switch to bypass Clerk for public job-feed testing.
# Only works when NODE_ENV is not production. Remove or set false before deployment.
THUNGATHA_AUTH_BYPASS=false

# Clerk authentication (server-side and public publishable key)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase project URL and publishable key for user-scoped requests
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for trusted ingestion RPCs. Never prefix with NEXT_PUBLIC_.
# Use the current Supabase secret key or a legacy service_role key.
SUPABASE_SECRET_KEY=

# Job providers (at least one provider must be configured)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# Optional: set to https://za.jooble.org/api when using a South Africa-specific Jooble key.
JOOBLE_API_BASE_URL=https://jooble.org/api
# GREENHOUSE_BOARD_TOKEN=

# Protects POST /api/internal/jobs/ingest. Use a long random value.
INGESTION_CRON_SECRET=
