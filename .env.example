# Groq is the primary hosted AI provider; Gemini is the fallback.
# Provider order in AI_ENABLED_PROVIDERS determines fallback order after AI_PROVIDER.
AI_PROVIDER=groq
AI_ENABLED_PROVIDERS=groq,gemini

GROQ_ENABLED=true
GEMINI_ENABLED=true
OLLAMA_LOCAL_ENABLED=false

# Groq (primary hosted provider)
GROQ_API_KEY=
GROQ_MODEL=

# Gemini (fallback hosted provider)
GEMINI_API_KEY=
GEMINI_MODEL=

# Ollama Local (optional; model must already be available from `ollama list`)
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434
OLLAMA_LOCAL_MODEL=

# Clerk authentication (server-side and public publishable key)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase project URL and publishable key for user-scoped requests
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key for Scout vacancy persistence
SUPABASE_SECRET_KEY=

# Protects POST /api/internal/ai-matching/worker for a scheduled worker invocation.
# Generate a unique value with: openssl rand -hex 32
AI_WORKER_SECRET=

# Scout API connection. Use the API base URL, including /api/v1.
SCOUT_API_BASE_URL=http://localhost:8000/api/v1
SCOUT_EXPORT_API_KEY=

# Scout export geography: cape_town, western_cape, south_africa, all
SCOUT_LOCATION_SCOPE=south_africa

# Protects both internal Scout POST endpoints. Generate a unique value with: openssl rand -hex 32
# Use the same value for the sync trigger and import request; keep it server-only.
SCOUT_SYNC_SECRET=
